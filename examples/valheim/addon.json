{
  "format": 1,
  "id": "valheim",
  "name": "Valheim",
  "subtitle": "Valheim Dedicated Server из Steam",
  "icon": "shield",
  "version": "2.0.0",
  "author": "Команда ConnectTogether",
  "requirements": { "ramGb": 4, "diskGb": 2.5 },
  "install": [
    { "id": "server", "type": "steamcmd", "appId": 896660 }
  ],
  "files": [ "valheim_server.exe" ],
  "settings": [
    { "id": "name", "label": "Название сервера", "type": "text", "default": "ConnectTogether" },
    { "id": "world", "label": "Мир", "type": "text", "default": "ConnectTogether" },
    { "id": "password", "label": "Пароль для входа: не короче 5 символов и не часть названия сервера", "type": "text", "default": "vikings" }
  ],
  "ports": [
    { "id": "game", "protocol": "udp", "default": 2456, "expose": true },
    { "id": "query", "protocol": "udp", "default": 2457, "expose": true }
  ],
  "launch": {
    "exe": "valheim_server.exe",
    "args": [
      "-nographics", "-batchmode",
      "-name", "{setting:name}",
      "-port", "{port:game}",
      "-world", "{setting:world}",
      "-password", "{setting:password}",
      "-public", "0",
      "-savedir", "{dir}/saves",
      "-logFile", "{dir}/server.log"
    ]
  },
  "log": { "file": "server.log" },
  "ready": { "log": "Game server connected", "timeoutSeconds": 600 },
  "console": { "type": "terminal" },
  "stop": { "signal": "ctrlC", "timeoutSeconds": 60 },
  "join": { "menuPath": [ "Начать игру", "Присоединиться к игре", "Подключиться по IP" ], "template": "{address}" },
  "guide": {
    "hint": "Сервер ставит ConnectTogether, нужна Valheim из Steam",
    "startSteps": [
      "Нажмите «Запустить мой сервер» — ConnectTogether скачает Valheim Dedicated Server из Steam и запустит его.",
      "Или запустите сервер сами: в Steam откройте Библиотеку → Инструменты → Valheim Dedicated Server, порт оставьте 2456.",
      "Дождитесь строки «Game server connected» и нажмите «Проверить снова»."
    ],
    "stoppedTips": [
      "Проверьте, не закрылся ли сервер Valheim.",
      "Запустите его снова — мир сохранится, комната и код останутся прежними.",
      "Нажмите «Проверить снова»."
    ],
    "helpUrl": "https://www.valheimgame.com/support/a-guide-to-dedicated-servers/",
    "helpLabel": "Как устроен сервер Valheim"
  }
}
